<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template — install-keychain-workaround.sh fills in __SCRIPT_PATH__ and
  __LOG_DIR__ and copies the result to ~/Library/LaunchAgents/. Runs the
  partition-list fix every 10 minutes; that's frequent enough relative to
  the multi-hour cadence at which Claude Code rewrites the credentials item.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bcollard.claudestatus.keychainfix</string>
    <key>ProgramArguments</key>
    <array>
        <string>__SCRIPT_PATH__</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/keychain-partition-fix.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/keychain-partition-fix.stderr.log</string>
</dict>
</plist>
