<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template — install-keychain-workaround.sh fills in __SCRIPT_PATH__,
  __LOG_DIR__, and __KEYCHAIN_DB__, then copies the result to
  ~/Library/LaunchAgents/.

  WatchPaths is the primary trigger: it re-runs the fix within seconds of
  any write to the login keychain file, closing the race window between
  "Claude Code resets the ACL" and "we re-apply it" — a 10-minute poll
  left a gap wide enough for ClaudeStatus's own 60s refresh to hit the
  reset ACL first and re-trigger the OS prompt. StartInterval stays as a
  fallback for the (rare) case a watch event is missed; RunAtLoad catches
  up right after login/wake.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bcollard.claudestatus.keychainfix</string>
    <key>ProgramArguments</key>
    <array>
        <string>__SCRIPT_PATH__</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>__KEYCHAIN_DB__</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/keychain-partition-fix.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/keychain-partition-fix.stderr.log</string>
</dict>
</plist>
